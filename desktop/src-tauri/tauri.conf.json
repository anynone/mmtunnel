{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MM Socket",
  "version": "0.1.0",
  "identifier": "cn.anynone.mmsocket",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "MM Socket",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../../bin/tunnel-daemon"
    ]
  }
}
