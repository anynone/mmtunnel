[Unit]
Description=MM Tunnel Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
WorkingDirectory=/opt/mmtunnel
ExecStart=/opt/mmtunnel/bin/tunnel-server -config /opt/mmtunnel/config/server.yaml
Restart=always
RestartSec=5

# Keep logs in journald.
StandardOutput=journal
StandardError=journal

# Basic hardening. Relax these if your deployment needs broader filesystem access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mmtunnel

[Install]
WantedBy=multi-user.target
